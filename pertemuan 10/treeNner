# DEFINISI DAN SPESIFIKASI OPERATOR POHON N-NER
def NBNDaun(P):
    """
    NBNDaun(P) memberikan banyaknya daun dari pohon P:
    Basis 0: IsTreeNEmpty((A)) = 0
    Basis 1: IsOneElmt((A)) = 1
    Rekurens: NBNDaun((A,  PN)) =  NBNDaun(PN)
    Contoh:
    NBNDaun(P) ->  5  terdapat  5  daun  pada  pohonN-ner  P
    """

# Realisasi
    if isTreeNEmpty(P):
        return 0
    elif isOneElmt(P):
        return 1
    else:
        return NBNDaun(Anak(P))


def NBNDaunChild(PN):
    """
    NBNDaunChild(PN) merekursif list of PohonN-ner yang merupakan
    anak-anak dari suatu akar:
    Basis: IsTreeNEmpty((A)) = 0
    Rekurens: NBNDaunChild(PN) = NBNDaun(FirstElmt(PN)) + NBNDaunChild(TailList(PN))
    """

# Realisasi
    if isTreeNEmpty(PN):
        return 0
    else:
        return NBNDaun(FirstElmt(PN)) + NBNDaunChild(tailList(PN))


# DEFINISI DAN SPESIFIKASI PREDIKAT
def IsMemberPN(P, X):
    """
    IsMemberPN(P, X) mengembalikan True jika X merupakan bagian dari P.
    Basis 0: IsTreeNEmpty((A)) = False
    Basis 1: IsOneElmt((A)) = A == X
    Rekurens: IsMember((A,  PN)) =  IsMemberPN(PN,  X)
    Contoh:
    IsMemberPN(P,  10) ->  False
    Tidak ada 10 pada pohon
    IsMemberPN(P,  8) ->  True
    Elemen 8 ada pada pohon
    """

# Realisasi
    if isTreeNEmpty(P):
        return False
    elif isOneElmt(P):
        return Akar(P) == X
    else:
        return Akar(P) == X or IsMemberChild(X, Anak(P))


def IsMemberChild(x, PN):
    """
    IsMemberChild(x, PN) mengembalikan True jika x ada di dalam list PN
    """

# Realisasi
    if isTreeNEmpty(PN):
        return False
    else:
        return IsMemberPN(FirstElmt(PN), x) or IsMemberChild(x, tailList(PN))


# DEFINISI DAN SPESIFIKASI OPERATOR
def SumPN(P):
    """
    SumPN(P) memberikan jumlah seluruh nilai elemen (node) dari pohon P:
    Basis 0: IsTreeNEmpty((A)) = 0
    Basis 1: IsOneElmt((A)) =  A
    Rekurens: SumPN((A,  PN)) =  A  +  SumPN(PN)
    Contoh:
    SumPN(P) ->  45
    2+3+1+4+5+9+7+6+8  =  45
    """

# Realisasi
    if isTreeNEmpty(P):
        return 0
    elif isOneElmt(P):
        return Akar(P)
    else:
        return Akar(P) + SumPNChild(Anak(P))


def SumPNChild(PN):
    """
    SumPNChild(PN) merekursif list of PohonN-ner:
    Basis: IsTreeNEmpty((A)) = 0
    Rekurens: SumPNChild(PN) = SumPN(FirstElmt(PN)) + SumPNChild(TailList(PN))
    """

# Realisasi
    if isTreeNEmpty(PN):
        return 0
    else:
        return SumPN(FirstElmt(PN)) + SumPNChild(tailList(PN))


# DEFINISI DAN SPESIFIKASI OPERATOR
def TinggiPN(P):
    """
    TinggiPN(P) memberikan tinggi pohon P, yaitu banyaknya node pada
    lintasan terpanjang dari akar ke daun:
    Basis 0: IsTreeNEmpty((A)) = 0
    Basis 1: IsOneElmt((A)) =  1
    Rekurens: TinggiPN((A,  PN)) =  1  +  max(TinggiPN(PN))
    Contoh:
    TinggiPN(P) ->  4
    lintasan terpanjang:  2  ->  3  ->  5  ->  9
    """

# Realisasi
    if isTreeNEmpty(P):
        return 0
    elif isOneElmt(P):
        return 1
    else:
        return 1 + TinggiPNChild(Anak(P))


def TinggiPNChild(PN):
    """
    TinggiPNChild(PN) merekursif list of PohonN-ner:
    Basis: IsTreeNEmpty((A)) = 0
    Basis: TailList(PN) kosong -> TinggiPN(FirstElmt(PN))
    Rekurens: TinggiPNChild(PN) =  max(TinggiPN(FirstElmt(PN)), TinggiPNChild(TailList(PN)))
    """

# Realisasi
    if isTreeNEmpty(PN):
        return 0
    elif isTreeNEmpty(tailList(PN)):
        return TinggiPN(FirstElmt(PN))
    else:
        return max(TinggiPN(FirstElmt(PN)), TinggiPNChild(tailList(PN)))


# DEFINISI DAN SPESIFIKASI OPERATOR
def CountX(P, X):
    """
    CountX(P, X) memberakan banyaknya kemunculan X pada pohon P:
    Basis 0: IsTreeNEmpty((A)) =  0
    Basis 1: IsOneElmt((A)) =  1  jika  A  ==  X,  0  jika  A  !=  X
    Rekurens: CountX((A,  PN),  X) =  (1  jika  A  ==  X,  0  jika  A  !=  X)  +  CountX(PN,  X)
    Contoh:
    CountX(P,  4) ->  1
    elemen  4  muncul  satu  kali
    CountX(P,  10) ->  0
    elemen  10  tidak  ada  pada  pohon
    """

# Realisasi
    if isTreeNEmpty(P):
        return 0
    elif isOneElmt(P):
        return 1 if Akar(P) == X else 0
    else:
        return (1 if Akar(P) == X else 0) + CountXChild(Anak(P), X)


def CountXChild(PN, X):
    """
    CountXChild(PN, X) merekursif list of PohonN-ner:
    Basis: IsTreeNEmpty((A)) = 0
    Rekurens: CountXChild(PN, X) = CountX(FirstElmt(PN), X) + CountXChild(TailList(PN), X)
    """

# Realisasi
    if isTreeNEmpty(PN):
        return 0
    else:
        return CountX(FirstElmt(PN), X) + CountXChild(tailList(PN), X)


# DEFINISI DAN SPESIFIKASI OPERATOR
def MaxPN(P):
    """
    MaxPN(P) memberakan nilai elemen terbesar dari pohon P yang tidak kosong:
    Basis 1: IsOneElmt((A)) =  A
    Rekurens: MaxPN((A,  PN)) =  max(A,  MaxPN(PN))
    Contoh:
    MaxPN(P) ->  9
    nilai terbesar pada pohon adalah  9
    """

# Realisasi
    if isOneElmt(P):
        return Akar(P)
    else:
        return max(Akar(P), MaxPNChild(Anak(P)))


def MaxPNChild(PN):
    """
    MaxPNChild(PN) merekursif list of PohonN-ner:
    Basis: IsTreeNEmpty((A)) =  -inf
    Basis: TailList(PN) kosong -> MaxPN(FirstElmt(PN))
    Rekurens: MaxPNChild(PN) =  max(MaxPN(FirstElmt(PN)), MaxPNChild(TailList(PN)))
    """

# Realisasi
    if isTreeNEmpty(PN):
        return float('-inf')
    elif isTreeNEmpty(tailList(PN)):
        return MaxPN(FirstElmt(PN))
    else:
        return max(MaxPN(FirstElmt(PN)), MaxPNChild(tailList(PN)))


# DEFINISI DAN SPESIFIKASI OPERATOR
def NBElmtLevel(P, L):
    """
    NBElmtLevel(P, L) memberakan banyaknya node pada level L (integer >= 1)
    dari pohon P, akar berada pada level 1:
    Basis 0: IsTreeNEmpty((A)) =  0
    Basis 1:  L  ==  1  ->  1
    Rekurens: NBElmtLevel((A,  PN),  L) =  NBElmtLevel(PN,  L-1)
    Contoh:
    NBElmtLevel(P,  3) ->  5
    level  3  berisi  1,  4,  5,  6,  8
    NBElmtLevel(P,  5) ->  0
    pohon tidak punya level 5
    """

# Realisasi
    if isTreeNEmpty(P) or L < 1:
        return 0
    elif L == 1:
        return 1
    else:
        return NBElmtLevelChild(Anak(P), L - 1)


def NBElmtLevelChild(PN, L):
    """
    NBElmtLevelChild(PN, L) merekursif list of PohonN-ner:
    Basis: IsTreeNEmpty((A)) = 0
    Rekurens: NBElmtLevelChild(PN, L) = NBElmtLevel(FirstElmt(PN), L) + NBElmtLevelChild(TailList(PN), L)
    """

# Realisasi
    if isTreeNEmpty(PN):
        return 0
    else:
        return NBElmtLevel(FirstElmt(PN), L) + NBElmtLevelChild(tailList(PN), L)


