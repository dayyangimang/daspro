# DEFINISI DAN SPESIFIKASI KONSTRUKTOR
def MakePN (A, C):
    """
    MakePN(A, C) membuat pohon N-ner dengan A sebagai akar dan C
    sebagai anak-anaknya. Bisa berupa daun maupun pohonN-ner utuh.
    """

# Realisasi
    return (A, C)


# DEFINISI DAN SPESIFIKASI KONSTRUKTOR
def Akar(PN):
    """
    Akar(P) adalah Akar dari P. Jika P adalah (A, PN) = Akar(P)
    adalah A.
    """

# Realisasi
    return PN[0]

def Anak(PN):
    """
    Anak(P) adalah list of pohon N-ner yang merupakan anak-anak
    dari P, dengan P adalah pohon N-ner yang tidak kosong.
    Jika P adalah (A, PN) = Anak (P) adalah PN.
    """

# Realisasi
    return PN[1]

# DEFINISI DAN SPESIFIKASI PREDIKAT
def isTreeNEmpty(PN):
    """
    IsTreeNEmpty(PN) bernilai True jika PN kosong : []
    """

# Realisasi
    return PN == []

def isOneElmt(PN):
    """
    IsOneElmt(PN) bernilai True jika PN hanya terdiri dari Akar.
    """

# Realisasi
    return (not isTreeNEmpty(PN)) and (isTreeNEmpty(Anak(PN)))

def NBNElmt(PN):
    """
    NBNElmt(PN) memberikan banyaknya node dari pohon P:
    Basis 0: IsTreeNEmpty((A)) = 0
    Basis 1: IsOneElmt((A)) = 1
    Rekurens: NBNElmt((A, PN)) = 1 + NBElmtChild(PN)
    """

# Realisasi
    if isTreeNEmpty(PN):
        return 0
    elif isOneElmt(PN):
        return 1
    else:
        return 1 + NBNElmtChild(Anak(PN))


def NBNElmtChild(PN):
    """
    NBNElmtChild(PN) merekursif list of PohonN-ner yang merupakan
    anak-anak dari suatu akar:
    Basis: IsTreeNEmpty((A)) = 0
    Rekurens: NBNElmtChild(PN) = NBNElmt(FirstElmt(PN)) +
    NBNElmtChild(TailList(PN))
    """

# Realisasi
    if isTreeNEmpty(PN):
        return 0
    else:
        return NBNElmt(FirstElmt(PN)) + NBNElmtChild(tailList(PN))



